@model Department
@{
    ViewBag.Title = "Изтрий отдел";
}
<h1 class="h3 mb-4">Изтрий отдел</h1>
<div class="alert alert-warning">
    <p>Сигурни ли сте, че искате да изтриете <strong>@Model.Name</strong>?</p>
    <p>В този отдел има <strong>@Model.PeopleDepartments.Count</strong> @(Model.PeopleDepartments.Count == 1 ? "контакт" : "контакта"), чийто отдел ще бъде изтрит.</p>
</div>

<form asp-action="Delete" method="post">
    <button type="submit" class="btn btn-danger">Да, изтрий</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>
