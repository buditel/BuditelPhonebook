@model Subject
@{
    ViewBag.Title = "Изтрий предмет";
}
<h1 class="h3 mb-4">Изтрий предмет</h1>
<div class="alert alert-warning">
    <p>Сигурни ли сте, че искате да изтриете <strong>@Model.Name</strong>?</p>
    <p>Има <strong>@Model.PeopleSubjects.Count</strong> @(Model.PeopleSubjects.Count == 1 ? "контакт" : "контакта"), чийто предмет ще бъде изтрит.</p>
</div>

<form asp-action="Delete" method="post">
    <button type="submit" class="btn btn-danger">Да, изтрий</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>
