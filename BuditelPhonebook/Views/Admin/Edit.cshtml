@model EditPersonViewModel
@{
    ViewBag.Title = "Редактирай контакт";
}
<h1 class="h3 mb-4">@ViewBag.Title</h1>

<form method="post" enctype="multipart/form-data" novalidate>
    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
    {

        <div class="mb-3">
            <label class="form-label">Име</label>
            <input type="text" class="form-control" name="FirstName" value="@Model.FirstName" placeholder="Въведете име..." required>
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Презиме</label>
            <input type="text" class="form-control" name="MiddleName" value="@Model.MiddleName" placeholder="Въведете бащино име (по желание)...">
            <span asp-validation-for="MiddleName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Фамилия</label>
            <input type="text" class="form-control" name="LastName" value="@Model.LastName" placeholder="Въведете фамилия..." required>
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Служебен имейл</label>
            <input type="email" class="form-control" name="Email" value="@Model.Email" placeholder="Въведете служебен имейл..." required>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    }
    <div class="mb-3">
        <label class="form-label">Личен телефон</label>
        <input type="text" class="form-control" name="PersonalPhoneNumber" value="@Model.PersonalPhoneNumber" placeholder="Въведете личен телефон...">
        <span asp-validation-for="PersonalPhoneNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Служебен телефон</label>
        <input type="text" class="form-control" name="BusinessPhoneNumber" value="@Model.BusinessPhoneNumber" placeholder="Въведете служебен телефон (по желание)...">
        <span asp-validation-for="BusinessPhoneNumber" class="text-danger"></span>
    </div>
    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
    {
        <div class="mb-3">
            <label class="form-label">Дата на постъпване</label>
            <input type="text" class="form-control datetime-picker dropdown-select" name="HireDate" value="@Model.HireDate" placeholder="Изберете дата на постъпване на работа...">
            <span asp-validation-for="HireDate" class="text-danger"></span>
        </div>
    }
    <div class="mb-3">
        <label class="form-label" for="fileInput">Снимка</label>

        <div class="d-flex align-items-md-start gap-3">
            @if (Model.ExistingPicture != null)
            {
                <div id="existingPictureContainer">
                    <label class="form-label">Текуща снимка:</label>
                    <div>
                        <img src="@($"data:image/webp;base64,{Convert.ToBase64String(Model.ExistingPicture)}")" alt="Current Picture" class="img-thumbnail" style="width: 150px; height: 150px; object-fit: contain;" />
                        <div class="mt-2">
                            <button type="button" class="btn btn-danger btn-sm" id="removePictureButton">Премахни</button>
                        </div>
                    </div>
                </div>

                <input asp-for="ExistingPicture" type="hidden" id="existingPicture" />
            }
            <div id="previewContainer" style="display: none;" class="">
                <label class="form-label">Нова снимка:</label>
                <div>
                    <img id="previewImage" src="#" alt="New Picture Preview" class="img-thumbnail" style="width: 150px; height: 150px; object-fit: contain;" />
                </div>
            </div>
        </div>
        <div class="mt-3">
            <input asp-for="PersonPicture" type="file" class="form-control" id="fileInput" name="PersonPicture" />
            <span class="file-name text-muted">Изберете файл (по желание)...</span>
            <span asp-validation-for="PersonPicture" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Рождена дата</label>
        <input type="text" class="form-control" name="Birthdate" value="@Model.Birthdate" placeholder="Въведете рождена дата (по желание)...">
        <span asp-validation-for="Birthdate" class="text-danger"></span>
    </div>
    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
    {
        <div class="mb-3">
            <label class="form-label">Длъжности</label>
            <div id="roleContainer">
                @for (int i = 0; i < Model.Roles.Count; i++)
                {

                    <div class="role-group d-flex align-items-center mt-2">
                        <select name="Roles[@i]" asp-for="Roles[i]" asp-items="@(new SelectList(Model.AvailableRoles, "Name", "Name"))" class="form-control dropdown-select">
                            <option value="">Изберете длъжност...</option>
                        </select>
                        @if (i > 0) // Only show remove button for additional ones
                        {
                            <button type="button" class="btn btn-sm btn-danger ms-2 remove-role">Премахни</button>
                        }
                    </div>
                    @if (i == 0)
                    {
                        <span asp-validation-for="Roles" class="text-danger"></span>
                    }
                }
            </div>
            <button type="button" class="btn btn-sm btn-success mt-2" id="addRole">Добави още</button>
        </div>
        <div id="subjectGroup" class="mb-3" style="display: none;">
            <label class="form-label">Група предмети</label>
            <select asp-for="SubjectGroup" class="form-control dropdown-select">
                <option value="">Изберете група предмети...</option>
                <option value="Професионални">Професионални</option>
                <option value="Общообразователни">Общообразователни</option>
            </select>
            <span asp-validation-for="SubjectGroup" class="text-danger"></span>
        </div>
        <div id="subject" class="mb-3" style="display: none;">
            <label class="form-label">Предмети</label>
            <div id="subjectContainer">
                @{
                    bool hasSubjects = Model.Subjects.Count > 0;
                }
                @if (!hasSubjects)
                {
                    Model.Subjects.Add(""); // Ensure at least one dropdown appears
                }

                @for (int i = 0; i < Model.Subjects.Count; i++)
                {

                    <div class="subject-group d-flex align-items-center mt-2">
                        <select name="Subjects[@i]" asp-for="Subjects[i]" asp-items="@(new SelectList(Model.AvailableSubjects, "Name", "Name"))" class="form-control dropdown-select">
                            <option value="">Изберете предмет...</option>
                        </select>
                        @if (i > 0) // Only show remove button for additional ones
                        {
                            <button type="button" class="btn btn-sm btn-danger ms-2 remove-subject">Премахни</button>
                        }
                    </div>
                    @if (i == 0)
                    {
                        <span asp-validation-for="Subjects" class="text-danger"></span>
                    }
                }
            </div>
            <button type="button" class="btn btn-sm btn-success mt-2" id="addSubject">Добави още</button>
        </div>
        <div class="mb-3">
            <label class="form-label">Отдели</label>
            <div id="departmentContainer">
                @for (int i = 0; i < Model.Departments.Count; i++)
                {

                    <div class="department-group d-flex align-items-center mt-2">
                        <select name="Departments[@i]" asp-for="Departments[i]" asp-items="@(new SelectList(Model.AvailableDepartments, "Name", "Name"))" class="form-control dropdown-select">
                            <option value="">Изберете отдел...</option>
                        </select>
                        @if (i > 0) // Only show remove button for additional ones
                        {
                            <button type="button" class="btn btn-sm btn-danger ms-2 remove-department">Премахни</button>
                        }
                    </div>
                    @if (i == 0)
                    {
                        <span asp-validation-for="Departments" class="text-danger"></span>
                    }
                }
            </div>
            <button type="button" class="btn btn-sm btn-success mt-2" id="addDepartment">Добави още</button>
        </div>
    }

    @if (!User.IsInRole("SuperAdmin") || !User.IsInRole("Admin"))
    {
        <input type="hidden" asp-for="FirstName" />
        <input type="hidden" asp-for="MiddleName" />
        <input type="hidden" asp-for="LastName" />
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="HireDate" />
        <input type="hidden" asp-for="SubjectGroup" />
        @for (int i = 0; i < Model.Departments.Count; i++)
        {
            <input type="hidden" name="Departments[@i]" value="@Model.Departments[i]" />
        }
        @for(int i = 0; i < Model.Roles.Count; i++)
        {
            <input type="hidden" name="Roles[@i]" value="@Model.Roles[i]" />
        }
        @for (int i = 0; i < Model.Subjects.Count; i++)
        {
            <input type="hidden" name="Subjects[@i]" value="@Model.Subjects[i]" />
        }
    }

    <button type="submit" class="btn btn-primary">Запиши</button>
    <a asp-controller="Phonebook" asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>
